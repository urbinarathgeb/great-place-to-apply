---
import Layout from '@/layouts/Layout.astro'
import ReviewForm from '@/components/vue/ReviewForm.vue'
import { db } from '@/db'
import { companies } from '@/db/schema/companies.schema'
import { categories } from '@/db/schema/categories.schema'
import { processStages } from '@/db/schema/process-stages.schema'
import { eq } from 'drizzle-orm'

const allCompanies = await db
  .select({
    id: companies.id,
    name: companies.name,
    slug: companies.slug,
    categoryName: categories.name,
  })
  .from(companies)
  .leftJoin(categories, eq(companies.categoryId, categories.id))
  .orderBy(companies.name)

const stages = await db
  .select({ id: processStages.id, name: processStages.name })
  .from(processStages)
  .orderBy(processStages.id)

const initialSlug = Astro.url.searchParams.get('company')
const initialCompany = initialSlug
  ? allCompanies.find((c) => c.slug === initialSlug) ?? null
  : null
---

<Layout title="Escribir review — Great Place To Apply">
  <section class="py-8 md:py-12 max-w-3xl mx-auto">
    <div class="text-center mb-8 md:mb-10">
      <h1 class="font-heading text-3xl md:text-5xl font-bold tracking-tight text-foreground">
        Tu experiencia importa
      </h1>
      <p class="mt-3 text-muted-foreground text-base md:text-lg max-w-xl mx-auto">
        Cuenta tu experiencia y ayuda a otros a saber qué esperar. Cada review hace que las empresas escuchen más.
      </p>
    </div>

    <div class="glass shadow-float rounded-2xl p-6 md:p-10">
      <ReviewForm
        companies={allCompanies}
        stages={stages}
        initial-company-id={initialCompany?.id ?? null}
        client:load
      />
    </div>

    <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="glass shadow-float rounded-2xl p-6 flex gap-3 items-start">
        <div class="p-2.5 bg-secondary-fixed text-secondary rounded-lg shrink-0">
          <svg
            width="20" height="20" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="round"
            stroke-linejoin="round" aria-hidden="true"
          >
            <path d="M12 2l8 4v6c0 5-3.5 8-8 10-4.5-2-8-5-8-10V6z" />
            <path d="m9 12 2 2 4-4" />
          </svg>
        </div>
        <div>
          <h2 class="text-sm font-semibold text-foreground">100% Anónimo</h2>
          <p class="text-sm text-muted-foreground mt-0.5">
            Las reviews son totalmente anónimas. Tu identidad nunca se revela.
          </p>
        </div>
      </div>
      <div class="glass shadow-float rounded-2xl p-6 flex gap-3 items-start">
        <div class="p-2.5 bg-primary-fixed text-primary rounded-lg shrink-0">
          <svg
            width="20" height="20" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="round"
            stroke-linejoin="round" aria-hidden="true"
          >
            <path d="M9 18h6" />
            <path d="M10 22h4" />
            <path d="M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.3 1 2.3h6c0-1 .4-1.8 1-2.3A7 7 0 0 0 12 2z" />
          </svg>
        </div>
        <div>
          <h2 class="text-sm font-semibold text-foreground">Consejo</h2>
          <p class="text-sm text-muted-foreground mt-0.5">
            Sé específico. Los detalles sobre el trato y el feedback son muy valorados por la comunidad.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
