---
import Layout from '@/layouts/Layout.astro'
import CompanyDirectory from '@/components/vue/CompanyDirectory.vue'
import { db } from '@/db'
import { companies } from '@/db/schema/companies.schema'
import { categories } from '@/db/schema/categories.schema'
import { reviews } from '@/db/schema/reviews.schema'
import { stageReviews } from '@/db/schema/stage-reviews.schema'
import { aspectRating } from '@/db/schema/aspect-rating.schema'
import { eq, sql, and, count } from 'drizzle-orm'
import { ilikeUnaccent } from '@/lib/search'

const LIMIT = 12

const q = Astro.url.searchParams.get('q') ?? ''
const category = Astro.url.searchParams.get('category') ?? ''

const conditions = []
if (q) {
  conditions.push(ilikeUnaccent(companies.name, `%${q}%`))
}
if (category) {
  conditions.push(eq(categories.slug, category))
}

const where = conditions.length > 0 ? and(...conditions) : undefined

const results = await db
  .select({
    id: companies.id,
    name: companies.name,
    slug: companies.slug,
    logoUrl: companies.logoUrl,
    categoryName: categories.name,
    categorySlug: categories.slug,
    reviewsCount: sql<number>`count(distinct ${reviews.id})::int`,
    avgScore: sql<string>`coalesce(avg(${aspectRating.score})::numeric(3,2), '0')`,
    latestComment: sql<string | null>`
      (SELECT comment FROM reviews
       WHERE reviews.company_id = ${companies.id}
       ORDER BY reviews.created_at DESC
       LIMIT 1)
    `,
    latestCommentDate: sql<string | null>`
      (SELECT to_char(reviews.created_at, 'YYYY-MM-DD"T"HH24:MI:SS')
       FROM reviews
       WHERE reviews.company_id = ${companies.id}
       ORDER BY reviews.created_at DESC
       LIMIT 1)
    `,
  })
  .from(companies)
  .leftJoin(categories, eq(companies.categoryId, categories.id))
  .leftJoin(reviews, eq(reviews.companyId, companies.id))
  .leftJoin(stageReviews, eq(stageReviews.reviewId, reviews.id))
  .leftJoin(aspectRating, eq(aspectRating.stageReviewId, stageReviews.id))
  .where(where)
  .groupBy(companies.id, categories.name, categories.slug)
  .orderBy(companies.name)
  .limit(LIMIT)

const [{ total }] = await db
  .select({ total: count() })
  .from(companies)
  .leftJoin(categories, eq(companies.categoryId, categories.id))
  .where(where)

const allCategories = await db
  .select({ id: categories.id, name: categories.name, slug: categories.slug })
  .from(categories)
  .orderBy(categories.name)

const pagination = {
  page: 1,
  limit: LIMIT,
  total,
  totalPages: Math.ceil(total / LIMIT),
}

const title = q
  ? `Resultados para "${q}" — Great Place To Apply`
  : 'Empresas — Great Place To Apply'
---

<Layout
  title={title}
  description="Explora las empresas mejor valoradas por sus propios empleados. Reviews anónimas de procesos de selección en Chile."
  wide
>
  <section class="pt-12 md:pt-20 pb-16 md:pb-24">
    <header class="text-center md:text-left max-w-3xl">
      <h1 class="text-3xl md:text-5xl font-heading font-extrabold tracking-tight text-foreground leading-[1.15]">
        Descubre tu próximo <span class="text-primary">gran paso.</span>
      </h1>
      <p class="mt-4 text-base md:text-lg text-muted-foreground leading-relaxed">
        Explora las empresas mejor valoradas por sus propios empleados y encuentra el lugar donde tu talento realmente brille.
      </p>
    </header>

    <div class="mt-8">
      <CompanyDirectory
        companies={results}
        pagination={pagination}
        categories={allCategories}
        initialQ={q}
        initialCategory={category}
        client:load
      />
    </div>
  </section>
</Layout>
