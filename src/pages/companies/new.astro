---
import Layout from '@/layouts/Layout.astro'
import CompanyForm from '@/components/vue/CompanyForm.vue'
import { db } from '@/db'
import { categories } from '@/db/schema/categories.schema'
import { asc } from 'drizzle-orm'

const allCategories = await db
  .select({ id: categories.id, name: categories.name, slug: categories.slug })
  .from(categories)
  .orderBy(asc(categories.name))
---

<Layout title="Agregar empresa — Great Place To Apply">
  <section class="py-8 md:py-12 max-w-2xl mx-auto">
    <h1 class="text-2xl font-heading font-bold text-foreground mb-8">
      Agregar empresa
    </h1>

    <CompanyForm categories={allCategories} client:load />
  </section>
</Layout>
