---
import Layout from '@/layouts/Layout.astro'
import CompanyForm from '@/components/vue/CompanyForm.vue'
import { db } from '@/db'
import { categories } from '@/db/schema/categories.schema'
import { asc } from 'drizzle-orm'

const allCategories = await db
  .select({ id: categories.id, name: categories.name, slug: categories.slug })
  .from(categories)
  .orderBy(asc(categories.name))
---

<Layout title="Agregar empresa — Great Place To Apply">
  <section class="px-4 py-8 md:py-12 max-w-2xl mx-auto">
    <div class="text-center mb-8 md:mb-10">
      <h1 class="font-heading text-3xl md:text-5xl font-bold tracking-tight text-foreground">
        Agregar Empresa
      </h1>
      <p class="mt-3 text-muted-foreground text-base md:text-lg max-w-xl mx-auto">
        Ayuda a otros a conocer cómo es el proceso de selección de esta empresa.
      </p>
    </div>

    <div class="glass shadow-float rounded-[2rem] p-6 md:p-10">
      <CompanyForm categories={allCategories} client:load />
    </div>
  </section>
</Layout>
