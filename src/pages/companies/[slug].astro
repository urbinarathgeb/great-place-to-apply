---
import Layout from '@/layouts/Layout.astro'
import Button from '@/components/ui/Button.astro'
import Badge from '@/components/ui/Badge.astro'
import CompanyReviews from '@/components/vue/CompanyReviews.vue'
import { db } from '@/db'
import { companies } from '@/db/schema/companies.schema'
import { categories } from '@/db/schema/categories.schema'
import { reviews } from '@/db/schema/reviews.schema'
import { stageReviews } from '@/db/schema/stage-reviews.schema'
import { processStages } from '@/db/schema/process-stages.schema'
import { aspectRating } from '@/db/schema/aspect-rating.schema'
import { eq, sql, inArray } from 'drizzle-orm'

const { slug } = Astro.params

const [company] = await db
  .select({
    id: companies.id,
    name: companies.name,
    slug: companies.slug,
    website: companies.website,
    careersUrl: companies.careersUrl,
    logoUrl: companies.logoUrl,
    description: companies.description,
    location: companies.location,
    categoryName: categories.name,
    categorySlug: categories.slug,
  })
  .from(companies)
  .leftJoin(categories, eq(companies.categoryId, categories.id))
  .where(eq(companies.slug, slug!))
  .limit(1)

if (!company) {
  return Astro.redirect('/404', 404)
}

const companyReviews = await db
  .select({
    id: reviews.id,
    role: reviews.role,
    recommends: reviews.recommends,
    comment: reviews.comment,
    avgScore: sql<string>`coalesce(avg(${aspectRating.score})::numeric(3,2), '0')`,
    createdAt: reviews.createdAt,
  })
  .from(reviews)
  .leftJoin(stageReviews, eq(stageReviews.reviewId, reviews.id))
  .leftJoin(aspectRating, eq(aspectRating.stageReviewId, stageReviews.id))
  .where(eq(reviews.companyId, company.id))
  .groupBy(reviews.id, reviews.role, reviews.recommends, reviews.comment, reviews.createdAt)
  .orderBy(sql`${reviews.createdAt} desc`)

const reviewIds = companyReviews.map((r) => r.id)

const reviewStages = reviewIds.length > 0
  ? await db
      .select({ reviewId: stageReviews.reviewId, name: processStages.name })
      .from(stageReviews)
      .innerJoin(processStages, eq(stageReviews.stageId, processStages.id))
      .where(inArray(stageReviews.reviewId, reviewIds))
  : []

const stagesByReview = new Map<string, string[]>()
for (const rs of reviewStages) {
  const list = stagesByReview.get(rs.reviewId) ?? []
  list.push(rs.name)
  stagesByReview.set(rs.reviewId, list)
}

const reviewItems = companyReviews.map((r) => ({
  id: r.id,
  role: r.role,
  recommends: r.recommends,
  createdAt: r.createdAt.toISOString(),
  comment: r.comment,
  avgScore: r.avgScore,
  stages: stagesByReview.get(r.id) ?? [],
}))

const aspectAverages = await db
  .select({
    aspectName: aspectRating.aspectName,
    avg: sql<string>`AVG(${aspectRating.score})::numeric(3,2)`,
  })
  .from(aspectRating)
  .innerJoin(stageReviews, eq(aspectRating.stageReviewId, stageReviews.id))
  .innerJoin(reviews, eq(stageReviews.reviewId, reviews.id))
  .where(eq(reviews.companyId, company.id))
  .groupBy(aspectRating.aspectName)

const [scoreRow] = await db
  .select({ score: sql<string>`coalesce(avg(${aspectRating.score})::numeric(3,2),'0')` })
  .from(aspectRating)
  .innerJoin(stageReviews, eq(aspectRating.stageReviewId, stageReviews.id))
  .innerJoin(reviews, eq(stageReviews.reviewId, reviews.id))
  .where(eq(reviews.companyId, company.id))

const overallScore = parseFloat(scoreRow?.score ?? '0')
const hasReviews = companyReviews.length > 0
const CIRC = 2 * Math.PI * 42

const aspectMeta: Record<string, { label: string; tagline: string; primary: boolean }> = {
  trato: { label: 'Trato', tagline: 'Ambiente respetuoso y empático.', primary: true },
  rapidez: { label: 'Rapidez', tagline: 'Procesos ágiles y eficientes.', primary: false },
  transparencia: { label: 'Transparencia', tagline: 'Claridad en las etapas y sueldos.', primary: true },
  feedback: { label: 'Feedback', tagline: 'Retroalimentación constructiva.', primary: false },
}

const aspectCards = ['trato', 'rapidez', 'transparencia', 'feedback'].map((key) => {
  const meta = aspectMeta[key]
  const avg = aspectAverages.find((a) => a.aspectName === key)?.avg
  const score = avg ? parseFloat(avg) : 0
  return {
    key,
    label: meta.label,
    tagline: meta.tagline,
    score: avg ?? '0',
    pct: Math.round((score / 5) * 100),
    primary: meta.primary,
    hasData: avg !== undefined,
  }
})

function gradeLabel(score: number) {
  if (score >= 4.5) return 'Excelente'
  if (score >= 4) return 'Muy bueno'
  if (score >= 3.5) return 'Bueno'
  if (score >= 3) return 'Regular'
  return 'Deficiente'
}

function initialsOf(name: string) {
  return name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((w) => w[0]?.toUpperCase() ?? '')
    .join('')
}
---

<Layout
  title={`${company.name} — Great Place To Apply`}
  description={company.description ?? `Reviews del proceso de selección en ${company.name}`}
  wide
>
  <section class="pt-10 md:pt-14 pb-4">
    <a
      href="/companies"
      class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-primary transition-colors"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M15 18l-6-6 6-6" />
      </svg>
      Empresas
    </a>

    <!-- Hero -->
    <div class="glass shadow-float rounded-3xl p-6 md:p-8 mt-5">
      <div class="flex flex-col lg:flex-row lg:items-center gap-6">
        <div class="flex items-center gap-4 lg:shrink-0">
          <span class="w-16 h-16 md:w-20 md:h-20 rounded-2xl bg-white shadow-sm border border-black/5 flex items-center justify-center font-heading font-extrabold text-primary text-2xl md:text-3xl">
            {initialsOf(company.name)}
          </span>
          <div class="flex flex-col items-start gap-2">
            {company.categoryName && (
              <Badge>{company.categoryName}</Badge>
            )}
            {hasReviews && (
              <span class="inline-flex items-center gap-1.5 rounded-full bg-gradient-to-br from-primary to-indigo-500 text-white text-sm font-bold px-3.5 py-1.5 shadow-[0_4px_14px_rgba(79,70,229,0.4)]">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="#fbbf24" stroke="#fbbf24" stroke-width="1.5" stroke-linejoin="round">
                  <path d="M12 2l2.9 6.26 6.85.71-5.15 4.6 1.48 6.72L12 17.1l-6.08 3.19 1.48-6.72-5.15-4.6 6.85-.71z" />
                </svg>
                {overallScore.toFixed(1)}
              </span>
            )}
          </div>
        </div>

        <div class="flex-1 min-w-0">
          <h1 class="text-2xl md:text-3xl lg:text-4xl font-heading font-extrabold tracking-tight text-primary leading-[1.15]">
            {company.name}
          </h1>
          {company.description && (
            <p class="mt-2 text-sm md:text-base text-muted-foreground leading-relaxed max-w-2xl">
              {company.description}
            </p>
          )}
          <div class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-muted-foreground">
            {company.location && (
              <span class="inline-flex items-center gap-1.5">
                <svg class="shrink-0" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                  <circle cx="12" cy="10" r="3" />
                </svg>
                {company.location}
              </span>
            )}
          </div>
        </div>

        <div class="flex flex-col sm:flex-row lg:flex-col gap-3 lg:shrink-0">
          {company.careersUrl && (
            <Button href={company.careersUrl} target="_blank" rel="noopener noreferrer" class="h-11 px-6">
              Ver empleos
            </Button>
          )}
          {company.website && (
            <Button
              href={company.website}
              target="_blank"
              rel="noopener noreferrer"
              variant={company.careersUrl ? 'outline' : 'default'}
              class="h-11 px-6"
            >
              Sitio web
            </Button>
          )}
        </div>
      </div>
    </div>

    <!-- Puntaje General -->
    {hasReviews && (
      <div class="grid gap-4 mt-8 md:grid-cols-3">
        <div class="glass shadow-float rounded-3xl p-6 flex flex-col items-center justify-center text-center">
          <div class="relative w-32 h-32">
            <svg class="w-32 h-32 -rotate-90" viewBox="0 0 100 100" role="img" aria-label={`Puntaje general ${overallScore.toFixed(1)} de 5`}>
              <circle cx="50" cy="50" r="42" fill="none" stroke="var(--color-primary-fixed)" stroke-width="10" />
              <circle
                cx="50" cy="50" r="42" fill="none"
                stroke="var(--color-primary)" stroke-width="10"
                stroke-linecap="round"
                stroke-dasharray={CIRC}
                stroke-dashoffset={CIRC * (1 - overallScore / 5)}
              />
            </svg>
            <div class="absolute inset-0 flex flex-col items-center justify-center">
              <span class="text-3xl font-extrabold tabular-nums text-foreground">{overallScore.toFixed(1)}</span>
              <span class="text-xs font-semibold text-muted-foreground">/ 5.0</span>
            </div>
          </div>
          <p class="mt-4 text-lg font-bold text-primary">{gradeLabel(overallScore)}</p>
          <p class="mt-1 text-xs text-muted-foreground leading-relaxed max-w-[210px]">
            Basado en {companyReviews.length} {companyReviews.length === 1 ? 'reseña anónima' : 'reseñas anónimas'} de quienes pasaron por su proceso de selección.
          </p>
        </div>

        <div class="md:col-span-2 grid grid-cols-1 sm:grid-cols-2 gap-4">
          {aspectCards.map((card) => {
            const track = card.primary ? 'bg-primary/15' : 'bg-secondary/15'
            const fill = card.primary ? 'bg-primary' : 'bg-secondary'
            const text = card.primary ? 'text-primary' : 'text-secondary'
            return (
              <div class="glass shadow-float rounded-3xl p-5 flex flex-col">
                <div class="flex items-center justify-between gap-2">
                  <span class="flex items-center gap-2 text-sm font-semibold text-foreground">
                    {card.key === 'trato' && (
                      <svg class={`shrink-0 ${text}`} width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                      </svg>
                    )}
                    {card.key === 'rapidez' && (
                      <svg class={`shrink-0 ${text}`} width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
                      </svg>
                    )}
                    {card.key === 'transparencia' && (
                      <svg class={`shrink-0 ${text}`} width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                        <circle cx="12" cy="12" r="3" />
                      </svg>
                    )}
                    {card.key === 'feedback' && (
                      <svg class={`shrink-0 ${text}`} width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
                      </svg>
                    )}
                    {card.label}
                  </span>
                  {card.hasData ? (
                    <span class={`text-sm font-bold tabular-nums ${text}`}>{card.score}</span>
                  ) : (
                    <span class="text-sm font-semibold text-muted-foreground/60">Sin datos</span>
                  )}
                </div>
                <div class={`mt-3 h-3 rounded-full overflow-hidden ${track}`}>
                  {card.hasData && (
                    <div class={`h-full rounded-full ${fill}`} style={`width: ${card.pct}%`}></div>
                  )}
                </div>
                <p class="mt-2 text-xs text-muted-foreground leading-relaxed">{card.tagline}</p>
              </div>
            )
          })}
        </div>
      </div>
    )}

    <!-- Reseñas -->
    <div class="mt-10 mb-4 flex items-center justify-between gap-4 flex-wrap">
      <h2 class="text-xl md:text-2xl font-heading font-bold text-foreground">
        Reseñas recientes
        <span class="text-muted-foreground font-medium text-lg">({companyReviews.length})</span>
      </h2>
      <Button href={`/reviews/new?company=${slug}`} variant="outline" size="sm">Escribir review</Button>
    </div>

    {hasReviews ? (
      <div class="mt-2">
        <CompanyReviews
          reviews={reviewItems}
          companyName={company.name}
          companySlug={company.slug}
          client:load
        />
      </div>
    ) : (
      <div class="glass shadow-float rounded-3xl p-10 text-center mt-2">
        <p class="text-muted-foreground font-medium">Aún no hay reseñas para esta empresa.</p>
        <p class="text-sm text-muted-foreground/60 mt-1">Sé el primero en compartir tu experiencia del proceso de selección.</p>
        <div class="mt-6 inline-flex">
          <Button href={`/reviews/new?company=${slug}`}>Escribir la primera review</Button>
        </div>
      </div>
    )}
  </section>
</Layout>
