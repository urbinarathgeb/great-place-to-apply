---
import Layout from '../layouts/Layout.astro'
import TopCompanyCard from '@/components/ui/TopCompanyCard.astro'
import SectionHeader from '@/components/ui/SectionHeader.astro'
import HomeSearch from '@/components/vue/HomeSearch.vue'
import Button from '@/components/ui/Button.astro'
import { db } from '@/db'
import { companies } from '@/db/schema/companies.schema'
import { categories } from '@/db/schema/categories.schema'
import { reviews } from '@/db/schema/reviews.schema'
import { stageReviews } from '@/db/schema/stage-reviews.schema'
import { aspectRating } from '@/db/schema/aspect-rating.schema'
import { eq, sql } from 'drizzle-orm'

const allCompanies = await db
  .select({
    id: companies.id,
    name: companies.name,
    slug: companies.slug,
    logoUrl: companies.logoUrl,
    categoryName: categories.name,
    categorySlug: categories.slug,
    reviewsCount: sql<number>`count(distinct ${reviews.id})::int`,
    avgScore: sql<string>`coalesce(avg(${aspectRating.score})::numeric(3,2), '0')`,
  })
  .from(companies)
  .leftJoin(categories, eq(companies.categoryId, categories.id))
  .leftJoin(reviews, eq(reviews.companyId, companies.id))
  .leftJoin(stageReviews, eq(stageReviews.reviewId, reviews.id))
  .leftJoin(aspectRating, eq(aspectRating.stageReviewId, stageReviews.id))
  .groupBy(companies.id, categories.name, categories.slug)
  .orderBy(companies.name)

const aspectAvgs = await db
  .select({
    companyId: reviews.companyId,
    aspectName: aspectRating.aspectName,
    avg: sql<string>`avg(${aspectRating.score})::numeric(3,2)`,
  })
  .from(aspectRating)
  .innerJoin(stageReviews, eq(aspectRating.stageReviewId, stageReviews.id))
  .innerJoin(reviews, eq(stageReviews.reviewId, reviews.id))
  .groupBy(reviews.companyId, aspectRating.aspectName)

const aspectTagLabels: Record<string, string> = {
  rapidez: 'Proceso rápido',
  feedback: 'Buen feedback',
  transparencia: 'Transparente',
  trato: 'Buen trato',
}

const aspectOrder = ['rapidez', 'trato', 'feedback', 'transparencia']

const topTagsByCompany: Record<string, string[]> = {}
for (const row of aspectAvgs) {
  ;(topTagsByCompany[row.companyId] ??= []).push(row.aspectName)
}
for (const companyId of Object.keys(topTagsByCompany)) {
  topTagsByCompany[companyId] = topTagsByCompany[companyId]
    .sort((a, b) => {
      const diff = parseFloat(
        aspectAvgs.find((r) => r.companyId === companyId && r.aspectName === b)!.avg,
      ) - parseFloat(
        aspectAvgs.find((r) => r.companyId === companyId && r.aspectName === a)!.avg,
      )
      if (diff !== 0) return diff
      return aspectOrder.indexOf(a) - aspectOrder.indexOf(b)
    })
    .slice(0, 2)
    .map((name) => aspectTagLabels[name] ?? name)
}

const top4 = allCompanies
  .filter((c) => c.reviewsCount > 0)
  .sort((a, b) => parseFloat(b.avgScore) - parseFloat(a.avgScore))
  .slice(0, 4)

const stats = [
  {
    label: 'Empresas',
    value: allCompanies.length,
  },
  {
    label: 'Empresas evaluadas',
    value: allCompanies.filter((c) => c.reviewsCount > 0).length,
  },
  {
    label: 'Reviews totales',
    value: allCompanies.reduce((acc, c) => acc + c.reviewsCount, 0),
  },
]

const valueProps = [
  {
    title: 'Reviews anónimas',
    description: 'Comparte tu experiencia sin miedo: tu identidad siempre estará protegida.',
    icon: 'shield-user',
    tone: 'primary',
  },
  {
    title: 'Feedback honesto',
    description: 'Opiniones directas y sinceras de quienes vivieron el proceso de selección.',
    icon: 'thumbs-up',
    tone: 'secondary',
  },
  {
    title: 'Procesos de selección',
    description: '¿Cómo es el proceso de selección? Conoce las etapas y tipos de pruebas.',
    icon: 'clipboard-list',
    tone: 'tertiary',
  },
]

const toneAccent: Record<string, string> = {
  primary: '#4f46e5',
  secondary: '#006c49',
  tertiary: '#45484f',
}

const toneIcon: Record<string, string> = {
  primary: 'bg-primary-fixed text-primary',
  secondary: 'bg-secondary-fixed/30 text-secondary',
  tertiary: 'bg-tertiary-fixed text-tertiary',
}

const toneTitle: Record<string, string> = {
  primary: 'text-primary',
  secondary: 'text-secondary',
  tertiary: 'text-tertiary',
}

const steps = [
  {
    title: 'Etapas del proceso',
    description: 'Conoce si hay 2 o 5 entrevistas antes de aplicar.',
  },
  {
    title: 'Pruebas técnicas',
    description: '¿Live coding o take-home? Descúbrelo por otros candidatos.',
  },
  {
    title: 'Tiempo de respuesta',
    description: 'Estimaciones reales basadas en experiencias recientes.',
  },
]

const icons: Record<string, string[]> = {
  'shield-user': [
    'M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1 1 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z',
    'M12 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6z',
    'M7 20.562V19a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v1.562',
  ],
  'thumbs-up': [
    'M7 10v12',
    'M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2a3.13 3.13 0 0 1 3 3.88Z',
  ],
  'clipboard-list': [
    'M8 6H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-2',
    'M15 2H9a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V3a1 1 0 0 0-1-1z',
    'M12 11h4',
    'M12 16h4',
    'M8 11h.01',
    'M8 16h.01',
  ],
}
---

<Layout title="Great Place To Apply — Reviews anónimas de procesos de selección" description="Descubre cómo es el proceso de selección en empresas de Chile. Reviews anónimas, puntuaciones y más." wide>
  <section class="pt-16 pb-14 md:pt-24 md:pb-20">
    <div class="text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 bg-secondary-fixed/20 text-secondary px-4 py-1.5 rounded-full mb-6 text-xs font-semibold">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21.8 10a2 2 0 0 0-1-2.3 2 2 0 0 0-1-2.5 2 2 0 0 0-2.5-1A2 2 0 0 0 15 2a2 2 0 0 0-2.3 1 2 2 0 0 0-2.5 1 2 2 0 0 0-1 2.5A2 2 0 0 0 8 8a2 2 0 0 0-1 2.3 2 2 0 0 0 1 2.5 2 2 0 0 0 1 2.5 2 2 0 0 0 2.5 1 2 2 0 0 0 2.3 1 2 2 0 0 0 2.5-1 2 2 0 0 0 2.5-1 2 2 0 0 0 1-2.5 2 2 0 0 0 1-2.3z" />
          <path d="m9 12 2 2 4-4" />
        </svg>
        Transparencia real en reclutamiento
      </div>

      <h1 class="text-4xl md:text-6xl font-heading font-extrabold tracking-tight text-primary leading-[1.05]">
        Descubre cómo es realmente<br class="hidden sm:block" />
        ese proceso.
      </h1>


      <p class="mt-4 text-base md:text-lg text-muted-foreground leading-relaxed max-w-xl mx-auto">
        Reviews anónimas sobre procesos de selección y cultura. Ayuda a otros
        candidatos a tomar la mejor decisión y prepararse.
      </p>

      <div class="mt-8">
        <HomeSearch companies={allCompanies} client:load />
      </div>
    </div>

    <div class="mt-14 md:mt-20 grid gap-6 sm:grid-cols-3 max-w-5xl mx-auto">
      {valueProps.map((v) => (
        <div class="glass shadow-float rounded-xl p-6 text-left" style={`border-left: 4px solid ${toneAccent[v.tone]}`}>
          <div class={`flex items-center justify-center w-12 h-12 rounded-full mb-4 ${toneIcon[v.tone]}`}>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              {icons[v.icon].map((d) => <path d={d} />)}
            </svg>
          </div>
          <h3 class={`font-heading text-sm font-semibold tracking-wide ${toneTitle[v.tone]}`}>{v.title}</h3>
          <p class="mt-2 text-xs font-medium text-muted-foreground leading-relaxed">{v.description}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="pb-14 md:pb-20">
    <div class="grid gap-6 sm:grid-cols-3 max-w-4xl mx-auto">
      {stats.map((s) => (
        <div class="glass shadow-float rounded-xl p-6 text-center">
          <p class="text-3xl md:text-4xl font-heading font-extrabold text-primary tabular-nums">{s.value}</p>
          <p class="mt-2 text-xs font-semibold text-muted-foreground uppercase tracking-wider">{s.label}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="pb-14 md:pb-20">
    <SectionHeader
      title="Empresas Top"
      subtitle="Las mejor valoradas por sus procesos de contratación."
      linkLabel="Ver todas"
      linkHref="/companies"
    />

    <div class="mt-10">
      {top4.length > 0 ? (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {top4.map((c) => (
            <TopCompanyCard company={c} tags={topTagsByCompany[c.id] ?? []} />
          ))}
        </div>
      ) : (
        <p class="text-center text-muted-foreground py-12">
          Aún no hay reseñas. Sé el primero en escribir una.
        </p>
      )}
    </div>
  </section>

  <section class="pb-14 md:pb-20">
    <div class="glass shadow-float rounded-3xl overflow-hidden">
      <div class="flex flex-col lg:flex-row">
        <div class="lg:w-1/2 p-8 md:p-12">
          <h2 class="text-2xl md:text-3xl font-heading font-bold tracking-tight text-primary">
            ¿Cómo es el proceso de selección?
          </h2>
          <p class="mt-4 text-base text-muted-foreground leading-relaxed">
            La incertidumbre es el mayor enemigo del talento. En Great Place To Apply,
            democratizamos la información de reclutamiento para que sepas qué esperar en cada paso.
          </p>
          <ul class="mt-8 space-y-6">
            {steps.map((s, i) => (
              <li class="flex items-start gap-4">
                <span class={`w-8 h-8 rounded-full flex items-center justify-center shrink-0 font-bold text-sm ${i % 2 === 0 ? 'bg-primary-fixed text-primary' : 'bg-secondary-fixed text-secondary'}`}>
                  {i + 1}
                </span>
                <div>
                  <h4 class="font-heading text-base font-semibold text-foreground">{s.title}</h4>
                  <p class="mt-1 text-sm text-muted-foreground leading-relaxed">{s.description}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>

        <div class="lg:w-1/2 relative min-h-[360px] flex items-center justify-center overflow-hidden"
          style="background: radial-gradient(60% 60% at 15% 15%, rgba(79,70,229,0.12), transparent), radial-gradient(60% 60% at 85% 85%, rgba(108,248,187,0.2), transparent)">
          <svg class="text-primary/20" width="140" height="140" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
            <path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" />
          </svg>

          <!--<div class="absolute bottom-4 left-4 right-4 md:bottom-6 md:left-6 md:right-6 glass shadow-float rounded-2xl p-5 border-l-4 border-secondary">-->
          <!--  <p class="italic text-sm md:text-base text-foreground leading-relaxed">-->
          <!--    &ldquo;Saber que el proceso tenía una prueba técnica de 3 horas me ayudó a organizarme mejor. Transparencia total.&rdquo;-->
          <!--  </p>-->
          <!--  <span class="mt-3 inline-block text-xs font-bold text-muted-foreground">— Ana G., Senior Dev</span>-->
          <!--</div>-->
        </div>
      </div>
    </div>
  </section>

  <section class="pt-16 md:pt-24 pb-16 md:pb-24 text-center relative overflow-hidden rounded-3xl">
    <div class="absolute inset-0 bg-primary opacity-[0.03]"></div>
    <div class="relative z-10 max-w-2xl mx-auto px-4">
      <h2 class="font-heading text-2xl md:text-3xl font-bold tracking-tight text-primary">
        ¿Tu empresa es un &ldquo;Great Place&rdquo;?
      </h2>
      <p class="mt-3 text-base text-muted-foreground leading-relaxed">
        Únete a miles de profesionales que están cambiando la forma en que buscamos trabajo. Tu opinión cuenta.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
        <Button href="/reviews/new" size="lg">Escribir mi experiencia</Button>
        <Button href="/companies" variant="outline" size="lg" class="!border-primary hover:!bg-primary-fixed">Explorar empresas</Button>
      </div>
    </div>
  </section>
</Layout>
