---
interface Company {
  id: string
  name: string
  slug: string
  categoryName: string | null
  reviewsCount: number
  avgScore: string
}

export interface Props {
  company: Company
  tags?: string[]
}

const { company, tags = [] } = Astro.props

const score = parseFloat(company.avgScore)
const initials = company.name
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((word) => word[0]?.toUpperCase() ?? '')
  .join('')
---

<a
  href={`/companies/${company.slug}`}
  class="glass rounded-xl p-6 md:p-7 shadow-float group cursor-pointer hover:shadow-lg transition-all duration-300 flex flex-col h-full"
>
  <div class="flex items-start justify-between gap-4">
    <span class="w-12 h-12 rounded-full bg-white shadow-sm border border-black/5 flex items-center justify-center font-bold text-base text-primary shrink-0">
      {initials}
    </span>

    <span class="inline-flex items-center gap-1.5 shrink-0 rounded-full bg-gradient-to-br from-primary to-indigo-500 text-white text-sm font-bold px-3.5 py-1.5 shadow-[0_4px_14px_rgba(79,70,229,0.4)]">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="#fbbf24" stroke="#fbbf24" stroke-width="1.5" stroke-linejoin="round">
        <path d="M12 2l2.9 6.26 6.85.71-5.15 4.6 1.48 6.72L12 17.1l-6.08 3.19 1.48-6.72-5.15-4.6 6.85-.71z" />
      </svg>
      {isNaN(score) ? '0' : score.toFixed(1)}
    </span>
  </div>

  <div class="mt-5">
    <h3 class="font-heading text-base font-semibold text-foreground group-hover:text-primary transition-colors leading-tight">
      {company.name}
    </h3>
    <p class="text-sm text-muted-foreground mt-1">
      {company.categoryName ?? 'Empresa'}
    </p>
  </div>

  <p class="text-sm text-muted-foreground mt-3">
    <span class="font-semibold text-foreground tabular-nums">{company.reviewsCount}</span>
    {company.reviewsCount === 1 ? ' review' : ' reviews'}
  </p>

  {tags.length > 0 && (
    <div class="flex flex-wrap gap-2 mt-auto pt-5">
      {tags.slice(0, 2).map((tag, i) => (
        <span class={`text-[10px] font-bold uppercase tracking-wider px-2 py-1 rounded-full ${i === 0 ? 'bg-secondary/10 text-secondary' : 'bg-primary/10 text-primary'}`}>
          {tag}
        </span>
      ))}
    </div>
  )}
</a>
