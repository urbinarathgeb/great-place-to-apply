---
interface Company {
  id: string
  name: string
  slug: string
  categoryName: string | null
  reviewsCount: number
  avgScore: string
}

export interface Props {
  company: Company
  tags?: string[]
}

const { company, tags = [] } = Astro.props

const score = parseFloat(company.avgScore)
const hasScore = !isNaN(score)
const initials = company.name
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((word) => word[0]?.toUpperCase() ?? '')
  .join('')
---

<a
  href={`/companies/${company.slug}`}
  class="glass rounded-xl p-4 shadow-float group cursor-pointer hover:shadow-lg transition-all duration-300 flex flex-col h-full border-white/20"
>
  <div class="relative h-32 rounded-lg overflow-hidden mb-3 bg-muted">
    <div class="absolute inset-0 aurora-bg" />
    <span class="absolute inset-0 flex items-center justify-center text-4xl font-extrabold tracking-tight text-primary/15 select-none">
      {initials}
    </span>
    <span class="absolute top-2 right-2 inline-flex items-center gap-1 bg-white/90 backdrop-blur-md px-2 py-1 rounded-full text-xs font-bold text-primary shadow-sm">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="#f59e0b" stroke="#f59e0b" stroke-width="1.5" stroke-linejoin="round">
        <path d="M12 2l2.9 6.26 6.85.71-5.15 4.6 1.48 6.72L12 17.1l-6.08 3.19 1.48-6.72-5.15-4.6 6.85-.71z" />
      </svg>
      {hasScore ? score.toFixed(1) : '—'}
    </span>
  </div>

  <div class="flex items-center gap-3 mb-2">
    <span class="w-10 h-10 rounded-lg bg-white shadow-sm border border-black/5 flex items-center justify-center font-bold text-sm text-primary shrink-0">
      {initials}
    </span>
    <div class="min-w-0">
      <h3 class="font-heading text-sm font-semibold text-foreground group-hover:text-primary transition-colors leading-tight truncate">
        {company.name}
      </h3>
      <p class="text-xs text-muted-foreground truncate">
        {company.categoryName ?? 'Empresa'}
      </p>
    </div>
  </div>

  <p class="text-xs text-muted-foreground">
    <span class="font-semibold text-foreground tabular-nums">{company.reviewsCount}</span>
    {company.reviewsCount === 1 ? ' review' : ' reviews'}
  </p>

  {tags.length > 0 && (
    <div class="flex flex-wrap gap-1.5 mt-auto pt-3">
      {tags.slice(0, 2).map((tag, i) => (
        <span class={`text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full ${i === 0 ? 'bg-secondary-fixed/10 text-secondary' : 'bg-primary/10 text-primary'}`}>
          {tag}
        </span>
      ))}
    </div>
  )}
</a>
