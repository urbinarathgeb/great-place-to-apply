---
export interface Props {
  score: number;
  max?: number;
  class?: string;
  size?: number;
  tone?: 'primary' | 'secondary';
}
const { score, max = 5, class: className, size: iconSize = 16, tone = 'secondary' } = Astro.props;
const stars = Array.from({ length: max }, (_, i) => i + 1);
const activeFill = tone === 'primary' ? 'text-primary fill-primary' : 'text-secondary fill-secondary';
const emptyStroke = tone === 'primary' ? 'fill-none stroke-primary/30 text-primary' : 'fill-none stroke-secondary/30 text-secondary';
const halfFill = tone === 'primary' ? 'text-primary fill-primary opacity-50' : 'text-secondary fill-secondary opacity-50';
---

<div class={`flex items-center gap-0.5 ${className ?? ''}`} aria-label={`${score} de ${max} estrellas`} role="img">
  {stars.map((star) => {
    const fill =
      score >= star
        ? activeFill
        : score >= star - 0.5
          ? halfFill
          : emptyStroke;
    return (
      <svg
        width={iconSize}
        height={iconSize}
        viewBox="0 0 24 24"
        class={fill}
      >
        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
      </svg>
    );
  })}
</div>
