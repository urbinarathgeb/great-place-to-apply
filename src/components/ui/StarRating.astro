---
export interface Props {
  score: number;
  max?: number;
  class?: string;
  size?: number;
}
const { score, max = 5, class: className, size: iconSize = 16 } = Astro.props;
const stars = Array.from({ length: max }, (_, i) => i + 1);
---

<div class={`flex items-center gap-0.5 ${className ?? ''}`} aria-label={`${score} de ${max} estrellas`} role="img">
  {stars.map((star) => {
    const fill =
      score >= star
        ? 'text-secondary fill-secondary'
        : score >= star - 0.5
          ? 'text-secondary fill-secondary opacity-50'
          : 'fill-none stroke-secondary/30 text-secondary';
    return (
      <svg
        width={iconSize}
        height={iconSize}
        viewBox="0 0 24 24"
        class={fill}
      >
        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
      </svg>
    );
  })}
</div>
