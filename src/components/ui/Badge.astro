---
export interface Props {
  variant?: 'default' | 'secondary' | 'destructive' | 'outline';
  class?: string;
}
const { variant = 'default', class: className } = Astro.props;

const variants: Record<string, string> = {
  default: 'bg-secondary/10 text-secondary',
  secondary: 'bg-primary/10 text-primary',
  destructive: 'bg-destructive/10 text-destructive',
  outline: 'text-muted-foreground border border-border',
};
---

<span
  class={`inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold transition-colors focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 ${variants[variant]} ${className ?? ''}`}
>
  <slot />
</span>
