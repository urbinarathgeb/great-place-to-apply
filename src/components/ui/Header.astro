---
import HeaderNav from '@/components/vue/HeaderNav.vue'
---

<header class="sticky top-0 z-50 w-full bg-white/40 backdrop-blur-xl border-b border-white/40">
  <div class="mx-auto flex h-16 items-center justify-between px-5 md:px-8 lg:px-10 max-w-7xl">
    <a href="/" class="flex items-center gap-2.5 font-heading text-lg font-bold tracking-tight text-primary">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-primary">
        <rect x="3" y="3" width="18" height="18" rx="4" />
        <path d="M9 12l2 2 4-4" />
      </svg>
      Great Place To Apply
    </a>
    <HeaderNav client:only="vue" />
  </div>
</header>
