---
import HeaderNav from '@/components/vue/HeaderNav.vue'
---

<header class="sticky top-0 z-50 w-full border-b bg-background backdrop-blur-md">
  <div class="mx-auto flex h-14 items-center justify-between px-4 md:px-6 lg:px-8 max-w-5xl">
    <a href="/" class="flex items-center gap-2 font-heading text-lg font-bold tracking-tight">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-accent">
        <rect x="3" y="3" width="18" height="18" rx="4" />
        <path d="M9 12l2 2 4-4" />
      </svg>
      Great Place To Apply
    </a>
    <HeaderNav client:only="vue" />
  </div>
</header>
