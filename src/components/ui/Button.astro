---
export interface Props {
  variant?: 'default' | 'secondary' | 'ghost' | 'outline' | 'destructive';
  size?: 'default' | 'sm' | 'lg' | 'icon';
  href?: string;
  target?: string;
  rel?: string;
  class?: string;
}
const { variant = 'default', size = 'default', href, target, rel, class: className } = Astro.props;

const variants: Record<string, string> = {
  default: 'btn-gradient text-white shadow-[0_4px_14px_rgba(79,70,229,0.25)] hover:shadow-[0_6px_24px_rgba(79,70,229,0.4)] hover:-translate-y-0.5',
  secondary: 'bg-secondary text-secondary-foreground hover:bg-secondary/80',
  ghost: 'hover:bg-primary/10 hover:text-primary',
  outline: 'border border-primary/30 text-primary hover:bg-primary/5',
  destructive: 'bg-destructive text-destructive-foreground hover:bg-destructive/90',
};

const sizes: Record<string, string> = {
  default: 'h-10 px-6',
  sm: 'h-8 px-4 text-xs',
  lg: 'h-12 px-8',
  icon: 'h-10 w-10',
};

const base = 'inline-flex items-center justify-center whitespace-nowrap rounded-full text-sm font-semibold transition-all duration-200 active:translate-y-0 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50';
const classes = `${base} ${variants[variant]} ${sizes[size]} ${className}`;
---
{
  href ? (
    <a href={href} target={target} rel={rel} class={classes}>
      <slot />
    </a>
  ) : (
    <button class={classes}>
      <slot />
    </button>
  )
}
